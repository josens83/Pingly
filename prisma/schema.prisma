// Prisma Schema for Pingly - SMS & Messenger Marketing Platform

generator client {
  provider   = "prisma-client-js"
  // JavaScript 엔진 사용 (바이너리 호환성 문제 해결, 번들 크기 감소)
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Connection Pooling용 직접 연결 (마이그레이션용)
  directUrl = env("DIRECT_URL")
}

// ==================== Authentication Models ====================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  phone         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  organization  Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

// ==================== Organization & Team ====================

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logo          String?
  website       String?
  industry      String?
  timezone      String   @default("Asia/Seoul")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  members       User[]
  contacts      Contact[]
  contactGroups ContactGroup[]
  campaigns     Campaign[]
  messages      Message[]
  subscription  Subscription?
  apiKeys       ApiKey[]
  senderIds     SenderId[]
  templates     MessageTemplate[]
  credits       CreditBalance?
  transactions  Transaction[]

  @@map("organizations")
}

// ==================== Contact Management ====================

model Contact {
  id            String    @id @default(cuid())
  phone         String
  email         String?
  name          String?
  firstName     String?
  lastName      String?
  company       String?
  tags          String[]
  customFields  Json?
  optInStatus   Boolean   @default(true)
  optInDate     DateTime?
  optOutDate    DateTime?
  source        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  groups         ContactGroupMember[]
  messages       Message[]

  @@unique([organizationId, phone])
  @@map("contacts")
}

model ContactGroup {
  id            String   @id @default(cuid())
  name          String
  description   String?
  color         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  members        ContactGroupMember[]
  campaigns      Campaign[]

  @@map("contact_groups")
}

model ContactGroupMember {
  id          String   @id @default(cuid())
  contact     Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId   String
  group       ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId     String
  addedAt     DateTime @default(now())

  @@unique([contactId, groupId])
  @@map("contact_group_members")
}

// ==================== Campaign & Messages ====================

model Campaign {
  id              String         @id @default(cuid())
  name            String
  description     String?
  type            MessageType
  status          CampaignStatus @default(DRAFT)
  content         String         @db.Text
  mediaUrl        String?
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?

  // Statistics
  totalRecipients Int            @default(0)
  sentCount       Int            @default(0)
  deliveredCount  Int            @default(0)
  failedCount     Int            @default(0)
  clickCount      Int            @default(0)
  optOutCount     Int            @default(0)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  targetGroup     ContactGroup?  @relation(fields: [targetGroupId], references: [id])
  targetGroupId   String?
  template        MessageTemplate? @relation(fields: [templateId], references: [id])
  templateId      String?
  messages        Message[]

  @@map("campaigns")
}

model Message {
  id              String        @id @default(cuid())
  type            MessageType
  status          MessageStatus @default(PENDING)
  content         String        @db.Text
  mediaUrl        String?

  // Tracking
  externalId      String?       // Provider message ID
  sentAt          DateTime?
  deliveredAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  clickedAt       DateTime?

  // Cost
  creditCost      Int           @default(1)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  contact         Contact       @relation(fields: [contactId], references: [id])
  contactId       String
  campaign        Campaign?     @relation(fields: [campaignId], references: [id])
  campaignId      String?
  senderId        SenderId?     @relation(fields: [senderIdId], references: [id])
  senderIdId      String?

  @@map("messages")
}

model MessageTemplate {
  id            String      @id @default(cuid())
  name          String
  type          MessageType
  content       String      @db.Text
  variables     String[]    // Template variables like {{name}}, {{company}}
  category      String?
  isApproved    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  campaigns      Campaign[]

  @@map("message_templates")
}

model SenderId {
  id            String       @id @default(cuid())
  name          String
  senderId      String       // Actual sender ID (phone number or alphanumeric)
  type          SenderIdType
  status        SenderIdStatus @default(PENDING)
  isDefault     Boolean      @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  messages       Message[]

  @@map("sender_ids")
}

enum MessageType {
  SMS
  LMS
  MMS
  RCS
  KAKAO_ALIMTALK
  KAKAO_FRIENDTALK
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  COMPLETED
  CANCELLED
}

enum MessageStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  CLICKED
  OPT_OUT
}

enum SenderIdType {
  PHONE_NUMBER
  ALPHANUMERIC
  SHORT_CODE
}

enum SenderIdStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ==================== Billing & Subscription ====================

model Plan {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String?

  // Pricing
  monthlyPrice      Int      // in cents/won
  yearlyPrice       Int      // in cents/won

  // Limits
  monthlyCredits    Int      // Number of messages included
  contactLimit      Int      // Max contacts
  campaignLimit     Int      // Max campaigns per month
  userLimit         Int      // Max team members

  // Features
  features          String[]
  hasApiAccess      Boolean  @default(false)
  hasAdvancedStats  Boolean  @default(false)
  hasPrioritySupport Boolean @default(false)

  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  subscriptions     Subscription[]

  @@map("plans")
}

model Subscription {
  id                String             @id @default(cuid())
  status            SubscriptionStatus @default(ACTIVE)

  // Billing
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean           @default(false)
  cancelledAt        DateTime?

  // Stripe
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Relations
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId    String             @unique
  plan              Plan               @relation(fields: [planId], references: [id])
  planId            String

  @@map("subscriptions")
}

model CreditBalance {
  id              String   @id @default(cuid())
  balance         Int      @default(0)
  bonusBalance    Int      @default(0)
  lastResetAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String       @unique

  @@map("credit_balances")
}

model CreditPackage {
  id            String   @id @default(cuid())
  name          String
  credits       Int
  bonusCredits  Int      @default(0)
  price         Int      // in cents/won
  pricePerCredit Float   // calculated price per credit
  isPopular     Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("credit_packages")
}

model Transaction {
  id              String          @id @default(cuid())
  type            TransactionType
  amount          Int             // in cents/won
  credits         Int?            // credits added/deducted
  description     String?

  // Payment details
  stripePaymentId String?
  paymentMethod   String?
  status          PaymentStatus   @default(PENDING)

  createdAt       DateTime        @default(now())

  // Relations
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String

  @@map("transactions")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  UNPAID
  TRIALING
}

enum TransactionType {
  SUBSCRIPTION
  CREDIT_PURCHASE
  REFUND
  CREDIT_USAGE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ==================== API & Integration ====================

model ApiKey {
  id            String    @id @default(cuid())
  name          String
  key           String    @unique
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  @@map("api_keys")
}

// ==================== System Settings ====================

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
