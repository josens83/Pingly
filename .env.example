# ================================
# Database
# ================================
DATABASE_URL="postgresql://user:password@localhost:5432/pingly?schema=public"
# Direct URL for Prisma migrations (bypasses connection pooler)
DIRECT_URL="postgresql://user:password@localhost:5432/pingly?schema=public"

# Docker PostgreSQL (for docker-compose)
POSTGRES_USER="pingly"
POSTGRES_PASSWORD="pingly_secret"
POSTGRES_DB="pingly"

# ================================
# Redis
# ================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD="pingly_redis"

# ================================
# NextAuth
# ================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# ================================
# OAuth Providers
# ================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# ================================
# Stripe
# ================================
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_STARTER_MONTHLY_PRICE_ID=""
STRIPE_STARTER_YEARLY_PRICE_ID=""
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=""
STRIPE_PROFESSIONAL_YEARLY_PRICE_ID=""
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=""
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=""

# ================================
# SMS Provider (Twilio)
# ================================
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ================================
# KakaoTalk Business API
# ================================
KAKAO_BUSINESS_API_KEY=""
KAKAO_SENDER_KEY=""

# ================================
# WebSocket / Real-time
# ================================
NEXT_PUBLIC_WS_URL=""

# ================================
# Monitoring & Analytics
# ================================
SENTRY_DSN=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ================================
# App Settings
# ================================
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ================================
# Feature Flags
# ================================
ENABLE_AI_FEATURES="false"
ENABLE_ANALYTICS="true"
